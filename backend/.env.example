# Copy this file to .env and fill in what you need. The app runs fine with
# no keys at all — mock data and the three keyless job APIs (Remotive,
# Arbeitnow, RemoteOK) don't need anything below.

# Firecrawl — powers career-page discovery and business-lead sourcing
# (/api/ingest/careers and /api/ingest/business). Get a key at
# https://www.firecrawl.dev. Without it, those two endpoints return 400
# and the app still runs fine on the keyless job sources alone.
FIRECRAWL_API_KEY=

# Signs session cookies. Auto-generated into data/.secret_key if left
# blank; set this yourself if you want logins to survive a data/ wipe.
SCOUT_SECRET_KEY=

# How often (seconds) the background loop refreshes the keyless job
# sources. Default is 6 hours.
SCOUT_INGEST_INTERVAL_SECONDS=21600
